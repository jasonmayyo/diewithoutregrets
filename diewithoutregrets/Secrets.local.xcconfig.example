//
//  Secrets.local.xcconfig.example
//
//  Copy this file to "Secrets.local.xcconfig" (same folder) and replace
//  the placeholder with your real OpenAI API key. The real file is
//  gitignored — never commit it.
//
//      cp Secrets.local.xcconfig.example Secrets.local.xcconfig
//      # then edit Secrets.local.xcconfig and paste your key
//
//  Secrets.xcconfig will pick it up automatically via #include?.
//

// REPLACE the value below with your real key, e.g.
// OPENAI_API_KEY = sk-proj-AbCd1234...
OPENAI_API_KEY = REPLACE_ME_OPENAI_API_KEY

// Sentry DSN — host-only (everything *after* `https://`).
//
// Get the full DSN from Sentry → Project Settings → Client Keys. It looks like:
//   https://<hash>@<region>.ingest.sentry.io/<project_id>
// Strip the leading `https://` and paste only the rest here. Example:
//   SENTRY_DSN = abc123@o123.ingest.us.sentry.io/456
//
// Why host-only: Xcode 26's xcconfig parser treats `//` as a line comment
// and silently truncates the value before substitution. The `$()//` escape
// that used to work on older Xcodes no longer does. SecretsLoader.swift
// prepends `https://` at runtime so SentrySDK still receives a complete URL.
SENTRY_DSN = REPLACE_ME_SENTRY_DSN
